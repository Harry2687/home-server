{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Group LinuxServer.io media stack updates together",
      "groupName": "linuxserver-media-stack",
      "schedule": ["before 5am on monday"],
      "matchPackageNames": [
        "/^ghcr\\.io/linuxserver//"
      ]
    },
    {
      "description": "Group Immich updates together (must run matching versions)",
      "groupName": "immich-stack",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ]
    }
  ]
}
