{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Group LinuxServer.io media stack updates together",
      "matchPackagePatterns": [
        "^ghcr\\.io/linuxserver/"
      ],
      "groupName": "linuxserver-media-stack",
      "schedule": ["before 5am on monday"]
    },
    {
      "description": "Group Immich updates together (must run matching versions)",
      "matchPackagePatterns": [
        "^ghcr\\.io/immich-app/"
      ],
      "groupName": "immich-stack"
    }
  ]
}
