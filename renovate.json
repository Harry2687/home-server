{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Group LinuxServer.io media stack updates together",
      "groupName": "linuxserver-media-stack",
      "schedule": ["before 5am on monday"],
      "matchPackageNames": [
        "/^ghcr\\.io/linuxserver//"
      ]
    },
    {
      "description": "Custom regex versioning for LinuxServer Jellyfin tags (e.g. 12.4ubu2604-ls61)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?ubu\\d+-ls(?<build>\\d+)$"
    },
    {
      "description": "Group Immich updates together (must run matching versions)",
      "groupName": "immich-stack",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ]
    },
    {
      "description": "Highlight and isolate major updates (breaking changes)",
      "matchUpdateTypes": ["major"],
      "labels": ["breaking", "major"],
      "dependencyDashboardApproval": true
    }
  ]
}
