{
	# Global options
	order crowdsec first
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_API_KEY}
	}
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# Reusable security headers
(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}
}

# CrowdSec snippet
(crowdsec) {
	crowdsec
}

# Public Services
jellyfin.harrys-lab.com {
	log
	import common_headers
	import crowdsec
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 15s
		propagation_timeout -1
	}
	reverse_proxy jellyfin:8096
}

immich.harrys-lab.com {
	log
	import common_headers
	import crowdsec
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 15s
		propagation_timeout -1
	}
	reverse_proxy immich_server:2283
}

# Internal Services (*.home.harrys-lab.com) with Wildcard TLS
*.home.harrys-lab.com, home.harrys-lab.com {
	import common_headers
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
		propagation_delay 15s
		propagation_timeout -1
	}

	@homepage host home.harrys-lab.com
	handle @homepage {
		reverse_proxy homepage:3000
	}

	@profilarr host profilarr.home.harrys-lab.com
	handle @profilarr {
		reverse_proxy profilarr:6868
